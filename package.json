{
  "name": "master-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "swagger:download": "curl -k -o swagger.json https://localhost:7163/swagger/v1/swagger.json",
    "swagger:generate": "npm run swagger:download && openapi-generator generate -g typescript-angular -i swagger.json -o swagger-api -p apiModulePrefix=Master && del swagger.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.16",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.16",
    "@angular/compiler": "^21.2.16",
    "@angular/core": "^21.2.16",
    "@angular/forms": "^21.2.16",
    "@angular/localize": "^21.2.16",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.16",
    "@angular/router": "^21.2.16",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/entity": "^21.0.1",
    "@ngrx/router-store": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "@progress/kendo-angular-buttons": "^22.0.1",
    "@progress/kendo-angular-common": "^24.1.0",
    "@progress/kendo-angular-conversational-ui": "^24.1.0",
    "@progress/kendo-angular-dateinputs": "^22.0.1",
    "@progress/kendo-angular-dialog": "^22.0.1",
    "@progress/kendo-angular-dropdowns": "^22.0.1",
    "@progress/kendo-angular-excel-export": "^24.1.0",
    "@progress/kendo-angular-grid": "^22.0.1",
    "@progress/kendo-angular-icons": "^22.0.1",
    "@progress/kendo-angular-indicators": "^22.0.1",
    "@progress/kendo-angular-inputs": "^22.0.1",
    "@progress/kendo-angular-intl": "^24.1.0",
    "@progress/kendo-angular-l10n": "^24.1.0",
    "@progress/kendo-angular-label": "^24.1.0",
    "@progress/kendo-angular-layout": "^22.0.1",
    "@progress/kendo-angular-menu": "^24.1.0",
    "@progress/kendo-angular-navigation": "^24.1.0",
    "@progress/kendo-angular-notification": "^22.0.1",
    "@progress/kendo-angular-pager": "^24.1.0",
    "@progress/kendo-angular-pdf-export": "^24.1.0",
    "@progress/kendo-angular-popup": "^24.1.0",
    "@progress/kendo-angular-progressbar": "^24.1.0",
    "@progress/kendo-angular-toolbar": "^22.0.1",
    "@progress/kendo-angular-treeview": "^24.1.0",
    "@progress/kendo-angular-upload": "^24.1.0",
    "@progress/kendo-angular-utils": "^24.1.0",
    "@progress/kendo-data-query": "^1.7.4",
    "@progress/kendo-drawing": "^1.25.2",
    "@progress/kendo-licensing": "^1.11.2",
